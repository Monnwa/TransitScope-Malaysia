# Historical classification archive settings are server-only.
# Apply classification-evidence.sql and classification-outbox.sql to the isolated database.
# This review candidate enables archival only outside Production when the flag is exactly true.
TRANSIT_CLASSIFICATION_ARCHIVE_ENABLED=false
TRANSIT_CLASSIFICATION_DATABASE_URL=
TRANSIT_CLASSIFICATION_RETENTION_DAYS=7
TRANSIT_CLASSIFICATION_DEFER_ADMISSION=0

# LinkBike server-only flags. Public release requires separate approval.
LINKBIKE_ENABLE_NON_PRODUCTION=false
LINKBIKE_ENABLE_PRODUCTION=false
