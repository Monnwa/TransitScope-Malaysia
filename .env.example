# Optional, server-only Redis REST credentials. Never use NEXT_PUBLIC_ for these.
# Leave both empty for the existing in-memory fallback. No database is created automatically.
TRANSIT_EVIDENCE_REDIS_REST_URL=
TRANSIT_EVIDENCE_REDIS_REST_TOKEN=
TRANSIT_EVIDENCE_RETENTION_MINUTES=60

# Optional server-side historical classification archive. Apply database/classification-evidence.sql
# and then database/classification-outbox.sql in the isolated database first.
# Use a separate database and leave empty until the archive is approved for the environment.
TRANSIT_CLASSIFICATION_DATABASE_URL=
TRANSIT_CLASSIFICATION_RETENTION_DAYS=7
# Local opt-in experiment. The outbox still protects candidates only after commit.
TRANSIT_CLASSIFICATION_DEFER_ADMISSION=0
